    {
      "name": "check (invalid salt)",
      "id": "9144483a-a7f1-5843-9166-d2fa173cbfe8",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Flip the last byte of the valid salt: same length, invalid signature.",
              "const salt = pm.variables.get(\"SALT\");",
              "const last = (parseInt(salt.slice(-2), 16) ^ 0xff).toString(16).padStart(2, \"0\");",
              "pm.variables.set(\"BAD_SALT\", salt.slice(0, -2) + last);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Authenticated request whose salt is not the taker's signature of the RFQ.",
              "pm.test(\"Status code is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Error explains the salt was rejected\", function () {",
              "    pm.expect(pm.response.json().error).to.match(/salt/i);",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "POST",
        "header": [
