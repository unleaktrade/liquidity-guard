    {
      "name": "ready",
      "id": "7688ae71-e962-4149-bdf5-8d15a5ca06ce",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Unauthenticated (orchestrator readiness probe): 200 when the Solana RPC answers,",
              "// 503 otherwise. EXPECT_READY_STATUS pins it (CI: 503, no RPC); default 200.",
              "const expected = Number(pm.variables.get(\"EXPECT_READY_STATUS\") || 200);",
              "pm.test(\"Status code is \" + expected, function () {",
              "    pm.response.to.have.status(expected);",
              "});",
              "",
              "if (expected === 200) {",
              "    pm.test(\"Status is ready\", function () {",
              "        pm.expect(pm.response.json().status).to.eql(\"ready\");",
              "    });",
              "} else {",
              "    pm.test(\"503 carries the JSON error envelope\", function () {",
              "        pm.expect(pm.response.json().error).to.be.a(\"string\").and.not.empty;",
              "    });",
              "}",
              "",
              "pm.test(\"X-Request-Id header present\", function () {",
              "    pm.expect(pm.response.headers.has(\"X-Request-Id\")).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
