    {
      "name": "metrics",
      "id": "3f6b0c1e-8d2a-4b7e-9c41-5a2e7d9f1b01",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Warm-up: HTTP metric families are created lazily on the first served request,",
              "// so a scrape right after a dyno restart would only show the RPC counter.",
              "pm.sendRequest(pm.variables.get(\"API_URL\") + \"/health\", function (err) {",
              "    if (err) { console.warn(\"warm-up /health failed:\", err); }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Bearer METRICS_TOKEN. /metrics accepts METRICS_TOKEN or any API key; it is open",
              "// only when neither METRICS_TOKEN nor API_KEYS is configured on the server.",
              "const token = pm.variables.get(\"METRICS_TOKEN\") || \"\";",
              "const apiKey = pm.variables.get(\"API_KEY\") || \"\";",
              "if (!token && apiKey) {",
              "    pm.test(\"No METRICS_TOKEN but API keys are set: 401 without a credential\", function () {",
              "        pm.response.to.have.status(401);",
              "    });",
              "} else {",
              "    pm.test(\"Status code is 200\", function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "",
              "    pm.test(\"Content-Type is Prometheus text format\", function () {",
              "        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\");",
              "    });",
              "",
              "    const body = pm.response.text();",
              "",
              "    pm.test(\"HTTP request counter is exposed\", function () {",
              "        pm.expect(body).to.include(\"# TYPE liquidity_guard_http_requests_total counter\");",
              "    });",
              "",
              "    pm.test(\"HTTP latency histogram is exposed\", function () {",
              "        pm.expect(body).to.include(\"liquidity_guard_http_requests_duration_seconds_bucket\");",
              "    });",
              "",
              "    pm.test(\"RPC counter is exposed with primary/fallback series\", function () {",
              "        pm.expect(body).to.include(\"# TYPE liquidity_guard_rpc_requests_total counter\");",
              "        pm.expect(body).to.match(/liquidity_guard_rpc_requests_total\\{[^}]*target=\"primary\"/);",
              "        pm.expect(body).to.match(/liquidity_guard_rpc_requests_total\\{[^}]*target=\"fallback\"/);",
              "    });",
              "",
              "    pm.test(\"/metrics does not count itself\", function () {",
              "        pm.expect(body).to.not.include('endpoint=\"/metrics\"');",
              "    });",
              "",
              "    pm.test(\"X-Request-Id header present\", function () {",
              "        pm.expect(pm.response.headers.has(\"X-Request-Id\")).to.be.true;",
              "    });",
              "}"
            ]
          }
        }
      ],
