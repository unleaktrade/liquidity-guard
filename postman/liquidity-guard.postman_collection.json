{
  "info": {
    "_postman_id": "c4d081b8-339e-4af3-bbf0-a61d904af8a9",
    "name": "unleaktrade-liquidity-guard",
    "description": "Liquidity Guard attestation service. Select one of the `*-liquidity guard` environments.\n\nEnvironment variables:\n- `API_URL`, `SERVICE_PUBKEY`, `SERVICE_NETWORK`: target instance.\n- `API_KEY`: one of the server's `API_KEYS` (sent as `X-API-Key`, or as `Authorization: Bearer`). Empty when the instance runs without API keys; the 401 assertions then turn into \"open\" assertions.\n- `METRICS_TOKEN`: bearer for `/metrics` (empty when unset on the instance).\n- `RFQ`, `TAKER`, `SALT`, `QUOTE_MINT`, `QUOTE_AMOUNT`, `BOND_AMOUNT_USDC`, `TAKER_FEE_BPS`: a `/check` request (`SALT` must be the taker's Ed25519 signature of the RFQ pubkey).\n- `EXPECT_CHECK_STATUS` (optional): pin the `/check` status (e.g. `200` on a SKIP_FUND_CHECKS instance).\n- `EXPECT_READY_STATUS` (optional, default `200`): expected `/ready` status (`503` when no RPC is reachable).\n\nAuth matrix: `/check` and `/metrics` need a credential when configured; `/health`, `/ready` and CORS preflights never do.\n\nThe repo copy lives in `postman/` and runs in CI with newman against an ephemeral local instance (`cargo run --example postman_env`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "health",
      "id": "84dbd42e-6826-4feb-92c6-9ecd63060e90",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// /health stays unauthenticated: it is polled by the app's HealthPill,",
              "// Docker HEALTHCHECK and uptime probes. This request sends no credential.",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let response = pm.response.json();",
              "",
              "pm.test(\"Service public key matches environment variable\", function () {",
              "    pm.expect(response.service_pubkey).to.eql(pm.variables.get(\"SERVICE_PUBKEY\"));",
              "});",
              "",
              "pm.test(\"Network matches environment variable\", function () {",
              "    pm.expect(response.network).to.eql(pm.variables.get(\"SERVICE_NETWORK\"));",
              "});",
              "",
              "pm.test(\"Response status is healthy\", function () {",
              "    pm.expect(response.status).to.eql(\"healthy\");",
              "});",
              "",
              "pm.test(\"skip_fund_checks is a boolean\", function () {",
              "    pm.expect(response.skip_fund_checks).to.be.a(\"boolean\");",
              "});",
              "",
              "pm.test(\"X-Request-Id header is a UUID\", function () {",
              "    pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "https://app.unleak.trade"
          }
        ],
        "url": {
          "raw": "{{API_URL}}/health",
          "host": [
            "{{API_URL}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "check (CORS preflight)",
      "id": "f7135314-0de0-48bd-9bc2-4dcb5f2577bb",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Preflights are answered by CORS before the rate limiter and the API key check.",
              "pm.test(\"Preflight is accepted (never 401)\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});",
              "",
              "pm.test(\"Wildcard Access-Control-Allow-Origin\", function () {",
              "    pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"*\");",
              "});",
              "",
              "pm.test(\"X-API-Key is an allowed request header\", function () {",
              "    pm.expect((pm.response.headers.get(\"Access-Control-Allow-Headers\") || \"\").toLowerCase()).to.include(\"x-api-key\");",
              "});",
              "",
              "pm.test(\"Access-Control-Max-Age is set\", function () {",
              "    pm.expect(Number(pm.response.headers.get(\"Access-Control-Max-Age\"))).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "OPTIONS",
        "header": [
          {
            "key": "Origin",
            "value": "https://app.unleak.trade"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "POST"
          },
          {
            "key": "Access-Control-Request-Headers",
            "value": "content-type,x-api-key"
          }
        ],
        "url": {
          "raw": "{{API_URL}}/check",
          "host": [
            "{{API_URL}}"
          ],
          "path": [
            "check"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "check",
      "id": "36d9c86f-142a-4817-859f-e66e222c050c",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 200 = proof issued; 400 = valid request but the taker lacks funds on this cluster.",
              "// Set EXPECT_CHECK_STATUS (e.g. 200 on a SKIP_FUND_CHECKS instance) to pin it.",
              "const expected = pm.variables.get(\"EXPECT_CHECK_STATUS\");",
              "if (expected) {",
              "    pm.test(\"Status code is \" + expected, function () {",
              "        pm.response.to.have.status(Number(expected));",
              "    });",
              "} else {",
              "    pm.test(\"Status code is 200 or 400 (insufficient funds)\", function () {",
              "        pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
              "    });",
              "}",
              "",
              "pm.test(\"X-Request-Id header is a UUID\", function () {",
              "    pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    let r = pm.response.json();",
              "    pm.test(\"commit_hash is 32 bytes hex\", function () {",
              "        pm.expect(r.commit_hash).to.match(/^[0-9a-f]{64}$/);",
              "    });",
              "    pm.test(\"liquidity_proof is a 64-byte Ed25519 signature hex\", function () {",
              "        pm.expect(r.liquidity_proof).to.match(/^[0-9a-f]{128}$/);",
              "    });",
              "    pm.test(\"service_pubkey matches environment variable\", function () {",
              "        pm.expect(r.service_pubkey).to.eql(pm.variables.get(\"SERVICE_PUBKEY\"));",
              "    });",
              "    pm.test(\"network matches environment variable\", function () {",
              "        pm.expect(r.network).to.eql(pm.variables.get(\"SERVICE_NETWORK\"));",
              "    });",
              "    pm.test(\"skip_fund_checks is a boolean\", function () {",
              "        pm.expect(r.skip_fund_checks).to.be.a(\"boolean\");",
              "    });",
              "    pm.test(\"Request fields are echoed back\", function () {",
              "        pm.expect(r.rfq).to.eql(pm.variables.get(\"RFQ\"));",
              "        pm.expect(r.taker).to.eql(pm.variables.get(\"TAKER\"));",
              "        pm.expect(r.salt).to.eql(pm.variables.get(\"SALT\"));",
              "        pm.expect(r.quote_mint).to.eql(pm.variables.get(\"QUOTE_MINT\"));",
              "        pm.expect(r.quote_amount).to.eql(pm.variables.get(\"QUOTE_AMOUNT\"));",
              "        pm.expect(r.bond_amount_usdc).to.eql(pm.variables.get(\"BOND_AMOUNT_USDC\"));",
              "        pm.expect(r.taker_fee_bps).to.eql(pm.variables.get(\"TAKER_FEE_BPS\"));",
              "    });",
              "    // The attestation is deterministic: remember it so the Bearer variant can compare.",
              "    pm.collectionVariables.set(\"LAST_COMMIT_HASH\", r.commit_hash);",
              "} else {",
              "    pm.test(\"400 carries an error message\", function () {",
              "        pm.expect(pm.response.json().error).to.be.a(\"string\").and.not.empty;",
              "    });",
              "}"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "https://app.unleak.trade"
          },
          {
            "key": "X-API-Key",
            "value": "{{API_KEY}}"
          }
        ],
        "url": {
          "raw": "{{API_URL}}/check",
          "host": [
            "{{API_URL}}"
          ],
          "path": [
            "check"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rfq\": \"{{RFQ}}\",\n  \"taker\": \"{{TAKER}}\",\n  \"salt\": \"{{SALT}}\",\n  \"quote_mint\": \"{{QUOTE_MINT}}\",\n  \"quote_amount\": \"{{QUOTE_AMOUNT}}\",\n  \"bond_amount_usdc\": \"{{BOND_AMOUNT_USDC}}\",\n  \"taker_fee_bps\": \"{{TAKER_FEE_BPS}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
