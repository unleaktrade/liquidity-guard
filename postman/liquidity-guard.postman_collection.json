    {
      "name": "check (no key)",
      "id": "c2b45cdd-090a-5c48-a273-f0401a3d2ded",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const authOn = (pm.variables.get(\"API_KEY\") || \"\").length > 0;",
              "",
              "if (authOn) {",
              "    pm.test(\"A request without a key is rejected with 401\", function () {",
              "        pm.response.to.have.status(401);",
              "    });",
              "    pm.test(\"WWW-Authenticate: Bearer challenge\", function () {",
              "        pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.eql(\"Bearer\");",
              "    });",
              "    pm.test(\"JSON error envelope is exactly {error: Unauthorized}\", function () {",
              "        pm.expect(pm.response.json()).to.eql({ error: \"Unauthorized\" });",
              "    });",
              "    pm.test(\"No proof is issued\", function () {",
              "        pm.expect(pm.response.text()).to.not.include(\"liquidity_proof\");",
              "    });",
              "} else {",
              "    pm.test(\"API_KEY unset in this environment: /check is open (not 401)\", function () {",
              "        pm.expect(pm.response.code).to.not.eql(401);",
              "    });",
              "}",
              "",
              "pm.test(\"CORS header present on the 401 too (browser can read the error)\", function () {",
              "    pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"*\");",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
