              "        pm.expect(r.bond_amount_usdc).to.eql(pm.variables.get(\"BOND_AMOUNT_USDC\"));",
              "        pm.expect(r.taker_fee_bps).to.eql(pm.variables.get(\"TAKER_FEE_BPS\"));",
              "    });",
              "    pm.test(\"Same commit_hash as the X-API-Key request (deterministic)\", function () {",
              "        const prev = pm.collectionVariables.get(\"LAST_COMMIT_HASH\");",
              "        if (prev) { pm.expect(r.commit_hash).to.eql(prev); }",
              "    });",
              "} else {",
              "    pm.test(\"400 carries an error message\", function () {",
              "        pm.expect(pm.response.json().error).to.be.a(\"string\").and.not.empty;",
              "    });",
              "}"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
